# SpiderFoot Test Environment Configuration
# Usage: op run --env-file="./.env.test" -- pytest ...
#
# For 1Password integration, replace values with op:// URIs:
#   SPIDERFOOT_DB_PASSWORD=op://DEV_VAULT/SpiderFoot-Test-DB/password

SPIDERFOOT_DB_TYPE=postgresql
SPIDERFOOT_DB_HOST=localhost
SPIDERFOOT_DB_PORT=5432
SPIDERFOOT_DB_NAME=spiderfoot_test
SPIDERFOOT_DB_USER=spiderfoot
SPIDERFOOT_DB_PASSWORD=spiderfoot_test_password
