# ============================================
# blking_local_proxy Environment Configuration
# ============================================
# Cleaned per env_vars_audit.csv on 2026-01-17

# ============================================
# Image Versions & Tags
# ============================================
# Elasticsearch
# RAGFlow

# ============================================
# RAGFlow Configuration
# ============================================

# RAGFlow Entrypoint Control
ENABLE_WEBSERVER=1
ENABLE_TASKEXECUTOR=1
ENABLE_DATASYNC=0
ENABLE_MCP_SERVER=1
ENABLE_ADMIN_SERVER=1
USE_DOCLING=0
INIT_SUPERUSER_ARG=1
CONSUMER_NO_BEG=0
CONSUMER_NO_END=0
WORKERS=1



RAGFLOW_IMAGE_TAG=v0.24.0-blkc
RAGFLOW_IMAGE=infiniflow/ragflow:${RAGFLOW_IMAGE_TAG}
RAGFLOW_COMPOSE_PROFILES=gpu

ELASTICSEARCH_BUILD_VERS=docker.elastic.co/elasticsearch/elasticsearch:9.2.4
ELASTICSEARCH_MCP_BUILD_VERS=elasticsearch-mcp-server:v20260224t062723---e1141c1

DOCKER_ES_HOST=elasticsearch
HOST_ES_HOST=elastic.blk.ing

RAGFLOW_DEVICE=gpu
RAGFLOW_MEM_LIMIT=8589934592
INTERNAL_DOMAIN=blk.ing

RAGFLOW_MYSQL_USER=rag_flow
RAGFLOW_MYSQL_HOST=ragflow-mysql
RAGFLOW_MYSQL_PORT=3306
RAGFLOW_MYSQL_DBNAME=rag_flow
RAGFLOW_MYSQL_PASSWORD=op://DEV_VAULT/local_infra/RAGFLOW_MYSQL_PASSWORD
RAGFLOW_MYSQL_MAX_PACKET=1073741824

RAGFLOW_MINIO_HOST=ragflow-minio
RAGFLOW_MINIO_PORT=9000
RAGFLOW_MINIO_USER=rag_flow
RAGFLOW_MINIO_PASSWORD=op://DEV_VAULT/local_infra/RAGFLOW_MINIO_PASSWORD
RAGFLOW_MINIO_BUCKET=ragflow
RAGFLOW_MINIO_PREFIX_PATH=ragflow

RAGFLOW_REDIS_HOST=redis
RAGFLOW_REDIS_PORT=6379
RAGFLOW_REDIS_PASSWORD=
RAGFLOW_REDIS_USERNAME=
#RAGFLOW_REDIS_URL=redis://${RAGFLOW_REDIS_HOST}:${RAGFLOW_REDIS_PORT}
RAGFLOW_REDIS_URL=redis://${RAGFLOW_REDIS_HOST}


RAGFLOW_ES_HOST=elasticsearch
RAGFLOW_ES_PORT=9200
RAGFLOW_STACK_VERSION=9.2.3
RAGFLOW_ELASTIC_PASSWORD=
RAGFLOW_ES_USER=elastic

RAGFLOW_DOC_ENGINE=elasticsearch
RAGFLOW_REGISTER_ENABLED=1
RAGFLOW_THREAD_POOL_MAX_WORKERS=128
RAGFLOW_DOC_BULK_SIZE=4
RAGFLOW_EMBEDDING_BATCH_SIZE=16
RAGFLOW_MAX_CONTENT_LENGTH=1073741824
RAGFLOW_MAX_CONCURRENT_CHATS=5

RAGFLOW_LLM_FACTORY=OpenAI
RAGFLOW_LLM_API_KEY=ollama
RAGFLOW_LLM_BASE_URL=https://ollama.blk.ing/api
RAGFLOW_LLM_CHAT_MODEL=gemma3:12b
RAGFLOW_LLM_EMBEDDING_MODEL=bge-m3
RAGFLOW_LLM_RERANK_MODEL=bge-reranker-v2
RAGFLOW_LLM_ASR_MODEL=dimavz/whisper-tiny

RAGFLOW_GOOGLE_DRIVE_WEB_OAUTH_REDIRECT_URI=https://ragflow.blk.ing/v1/connector/google-drive/oauth/web/callback
RAGFLOW_GOOGLE_GMAIL_OAUTH_REDIRECT_URI="https://ragflow.blk.ing/v1/connector/gmail/oauth/web/callback"
RAGFLOW_SECRET_KEY=op://DEV_VAULT/local_infra_apikeys/RAGFLOW_SECRET_KEY

# RAGFlow MCP Server
RAGFLOW_MCP_API_KEY=op://DEV_VAULT/local_infra_apikeys/RAGFLOW_MCP_API_KEY

# RAGFlow optional settings
RAGFLOW_STORAGE_IMPL=MINIO
RAGFLOW_DB_TYPE=mysql
DEVICE=gpu
# Database images
POSTGRES_TAG=17
REDIS_TAG=8.2-alpine
MONGO_TAG=8.0.11
# Proxy & Infrastructure images
TRAEFIK_IMAGE=traefik
TRAEFIK_TAG=latest
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy
SOCKET_PROXY_TAG=latest

# Application images
SONARQUBE_TAG=community
OLLAMA_TAG=latest
JELLYFIN_TAG=latest
UNIFI_IMAGE=lscr.io/linuxserver/unifi-network-application
UNIFI_TAG=latest
AUDIOMUSE_IMAGE=ghcr.io/neptunehub/audiomuse-ai
AUDIOMUSE_TAG=latest-nvidia


# Custom build versions (full image paths with registry)
NUMBER_TWO_SCOPE_BUILD_VERS=number-two-scope:v20260309t014501---43f6be46
THRESHER_DEEP_BUILD_VERS=thresher-deep:v20260226t081231---07baf2f
TOR_PROXY_BUILD_VERS=us-central1-docker.pkg.dev/intranet-of-tools/blkc-infrastructure/blkc-tor-proxy:tor-proxy-20251024t170418---6d8b9f9

# ============================================
# Domain Configuration
# ============================================
# Internal domain for LAN services
INTERNAL_DOMAIN=blk.ing

# Public domain for internet-facing services
TRAEFIK_DOMAIN=blk.ing

# Dashboard (used by internal-proxy)
DASHBOARD_URL=https://dashboard.blk.ing
DASHBOARD_PORT=3001

# ============================================
# Database Configuration - PostgreSQL
# ============================================
# Main PostgreSQL superuser credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""
POSTGRES_HOST=unified-postgres
POSTGRES_PORT=5432

# Service-specific database passwords (used in docker-compose)
POSTGRES_THRESHER_PASSWORD=op://DEV_VAULT/local_infra/POSTGRES_THRESHER_PASSWORD
POSTGRES_SONARQUBE_PASSWORD=op://DEV_VAULT/local_infra/POSTGRES_SONARQUBE_PASSWORD
POSTGRES_AUDIOMUSE_PASSWORD=op://DEV_VAULT/local_infra/POSTGRES_AUDIOMUSE_PASSWORD

# Service-specific database configuration
POSTGRES_AUDIOMUSE_DB=audiomuse
POSTGRES_AUDIOMUSE_USER=audiomuse

# ============================================
# Database Configuration - MongoDB
# ============================================
# MongoDB for UniFi Controller
MONGO_HOST=cloudkey-db
MONGO_PORT=27017
MONGO_USER=mongo_user
MONGO_DBNAME=unifi_db
MONGO_ADMIN=mongo_admin
MONGO_ADMIN_PASSWORD=op://DEV_VAULT/local_infra/MONGO_ADMIN_PASSWORD
MONGO_USER_PASSWORD=op://DEV_VAULT/local_infra/MONGO_USER_PASSWORD
MONGO_AUTHSOURCE=admin
MONGO_PASS=op:/DEV_VAULT/local_infra/MONGO_PASS
MEM_LIMIT=1024
MEM_STARTUP=1024
MONGO_TLS=true
# ============================================
# Redis Configuration
# ============================================
REDIS_DOCKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis.blk.ing

# ============================================
# User/Group IDs
# ============================================
# Default user/group IDs for most services
PUID=1000
PGID=1000

# Service-specific user/group IDs
NUMBER_TWO_SCOPE_PUID=1000
NUMBER_TWO_SCOPE_PGID=1000
THRESHER_DEEP_PUID=1000
THRESHER_DEEP_PGID=1000
TOR_USER=debian-tor
TOR_GROUP=debian-tor

# ============================================
# Traefik Configuration
# ============================================
# Traefik API Dashboard (used in docker-compose command args)
TRAEFIK_int_API_DASHBOARD=true
TRAEFIK_ext_API_DASHBOARD=false

# ============================================
# SpiderFoot Configuration
# ============================================
# SpiderFoot database configuration (used in number-two-scope service)
SPIDERFOOT_DB=spiderfoot_db
SPIDERFOOT_DB_USER=postgres
SPIDERFOOT_USER=op://DEV_VAULT/local_infra/SPIDERFOOT_USER
SPIDERFOOT_PASSWORD=op://DEV_VAULT/local_infra/SPIDERFOOT_PASSWORD
SPIDERFOOT_DB_PASSWORD=op://DEV_VAULT/local_infra/SPIDERFOOT_PASSWORD

# ============================================
# SonarQube Configuration
# ============================================
SONAR_USER=sonarqube
SONAR_ES_BOOTSTRAP_CHECKS_DISABLE=true

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_SERVER_DOCKE_URL=http://ollama:11434/api
OLLAMA_SERVER_URL=https://ollama.blk.ing/api
OLLAMA_MODEL_NAME=gemma3:12b

# Ollama GPU Optimization
OLLAMA_GPU_OVERHEAD=3221225472
OLLAMA_NUM_GPU=1
OLLAMA_NUM_PARALLEL=3

# Ollama Performance Tuning
#OLLAMA_LOW_VRAM_THRESHOLD=8589934592
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q4_0
OLLAMA_MAX_QUEUE=256
OLLAMA_KEEP_ALIVE=10m

OLLAMA_LLM_LIBRARY=cuda
#CUDA_VISIBLE_DEVICES=0

# Ollama Debugging
OLLAMA_DEBUG=false
CUDA_ERROR_LEVEL=25

# ============================================
# Jellyfin Configuration
# ============================================
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_TOKEN=op://DEV_VAULT/local_infra/JELLYFIN_TOKEN
JELLYFIN_USER_ID=b508258302a649cab668cad9ba15d1a8

# ============================================
# AudioMuse AI Configuration
# ============================================
MEDIASERVER_TYPE=jellyfin
AUDIOMUSE_LOG_LEVEL=info
USE_GPU_CLUSTERING=true

# ============================================
# Gunicorn WSGI Server Configuration
# ============================================
GUNICORN_WORKERS=5
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=90

# ============================================
