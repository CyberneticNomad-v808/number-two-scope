# BL King Consulting Docker Build & Deploy Configuration
# This file contains environment variables for Docker build and deployment operations
# Source this file in shell scripts using: source docker.blkc.config

# Product Information
PRODUCT="number-two-scope"
PRODUCT_URL="https://github.com/CyberneticNomad-v808/number-two-scope"
PROJECT_NAME="number-two-scope"  # Used for build version prefix
PRODUCT_DESCRIPTION="Number-Two-Scope (Attack Scope) - OSINT automation tool with 277+ modules"

# Google Cloud Configuration
REGION="us-central1"
PROJECT="intranet-of-tools"
REPOSITORY="blkc-foot-enterprise"

# Docker Image Configuration
IMAGE_NAME="number-two-scope"
REGISTRY="${REGION}-docker.pkg.dev/${PROJECT}/${REPOSITORY}/${IMAGE_NAME}"

# Deployment Configuration
DEPLOYMENT_DIR="/stuff/infrastructure/blking_local_proxy/"
IMAGE_TAG="version"
