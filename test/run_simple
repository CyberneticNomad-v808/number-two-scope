#!/usr/bin/env bash
#
# Simple SpiderFoot Test Runner - No Hanging Version

set -euo pipefail

# Trap Ctrl+C to exit gracefully
trap 'echo -e "\n\n[INTERRUPTED] Test execution stopped by user"; exit 130' SIGINT SIGTERM

# Script setup
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

# Validate database configuration
setup_safe_database_env() {
    # PostgreSQL-only configuration (SQLite support removed in bd8df866)
    # Require explicit configuration - no fallbacks

    local missing=()
    [[ -z "${SPIDERFOOT_DB_TYPE:-}" ]] && missing+=("SPIDERFOOT_DB_TYPE")
    [[ -z "${SPIDERFOOT_DB_HOST:-}" ]] && missing+=("SPIDERFOOT_DB_HOST")
    [[ -z "${SPIDERFOOT_DB_PORT:-}" ]] && missing+=("SPIDERFOOT_DB_PORT")
    [[ -z "${SPIDERFOOT_DB_NAME:-}" ]] && missing+=("SPIDERFOOT_DB_NAME")
    [[ -z "${SPIDERFOOT_DB_USER:-}" ]] && missing+=("SPIDERFOOT_DB_USER")

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}[ERROR]${NC} Missing required environment variables: ${missing[*]}"
        echo ""
        echo "Set environment variables:"
        echo "  export SPIDERFOOT_DB_TYPE=postgresql"
        echo "  export SPIDERFOOT_DB_HOST=localhost"
        echo "  export SPIDERFOOT_DB_PORT=5432"
        echo "  export SPIDERFOOT_DB_NAME=spiderfoot_test"
        echo "  export SPIDERFOOT_DB_USER=spiderfoot"
        echo "  export SPIDERFOOT_DB_PASSWORD=''"
        echo ""
        echo "Or use ./test/run for interactive configuration."
        exit 2
    fi

    log_info "Database: PostgreSQL - ${SPIDERFOOT_DB_USER}@${SPIDERFOOT_DB_HOST}:${SPIDERFOOT_DB_PORT}/${SPIDERFOOT_DB_NAME}"
    log_info "Note: Unit tests mock database connections (conftest.py patches psycopg2.connect)"
}

run_tests() {
    log_info "Running SpiderFoot unit tests..."

    cd "${PROJECT_ROOT}" || exit 1
    setup_safe_database_env

    local args=(
        "test/unit/"
        "--tb=short"
        "--maxfail=5"
    )

    # Add user arguments
    args+=("$@")

    log_info "Press Ctrl+C to interrupt tests"

    if command -v pytest >/dev/null 2>&1; then
        pytest "${args[@]}"
    else
        python3 -m pytest "${args[@]}"
    fi
}

main() {
    if [[ "${1:-}" == "-h" ]]; then
        echo "Usage: $0 [pytest-args]"
        echo "Simple test runner that avoids hanging issues"
        exit 0
    fi
    
    run_tests "$@"
}

main "$@"
